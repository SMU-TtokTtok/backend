# /opt/ttokttok/app/.env 템플릿. setup.sh 가 여기서 복사해 만든다.
#
#   cp .env.example .env && chmod 600 .env
#
# 여기 있는 값은 전부 플레이스홀더다. 실제 시크릿을 이 파일에 적지 말 것.
# AWS 에서 이관하면서 DB/Redis/스토리지가 모두 새로 생성되므로, 기존 운영
# 자격증명을 재사용하지 말고 이 기회에 전부 새로 발급하는 것을 권장한다.

### 도메인 ###
# API 도메인(인증서 발급 기준이 되는 대표 이름).
DOMAIN=www.hearmeout.kr
# server_name 에 들어갈 이름 전부. 공백으로 구분한다.
SERVER_NAMES=www.hearmeout.kr hearmeout.kr
# 파일 도메인. 아래 FILE_CLOUD_URL 의 호스트와 반드시 같아야 한다.
FILE_DOMAIN=www.ddockddock-file.co.kr
FILE_SERVER_NAMES=www.ddockddock-file.co.kr ddockddock-file.co.kr
# Let's Encrypt 알림 수신 주소
CERT_EMAIL=admin@example.com

# nginx 업로드 상한. application-prod.yml 의
# spring.servlet.multipart.max-request-size(50MB)와 맞춘다. 톰캣의
# max-swallow-size 가 60MB 로 더 크게 잡혀 있어, 초과 요청이 잘려도 톰캣이
# 본문을 끝까지 읽고 정상적인 오류 응답을 돌려줄 수 있다.
MAX_BODY=50M

### PostgreSQL ###
# 덤프 복원용 슈퍼유저. 백업 SQL 의 객체 소유자가 postgres 라서 이 값을 바꾸면
# `ALTER ... OWNER TO postgres` 가 "role does not exist" 로 실패한다.
POSTGRES_DB=ttokttok
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# 앱이 런타임에 쓰는 최소권한 롤 (init-db/00-roles.sh 가 생성). DML 만 가능하다.
APP_DB_USER=ttokttok_app
APP_DB_PASSWORD=change-me
# Flyway 전용 롤. public 스키마 객체의 소유자가 되어 DDL 을 실행한다.
#
# 앱 롤에 소유권을 주지 않고 롤을 나누는 이유는, 앱이 탈취되더라도 DROP TABLE
# 이 불가능하게 두기 위해서다. PostgreSQL 에서 ALTER/DROP 은 GRANT 로 넘길 수
# 없고 소유자에게만 허용되므로, 권한을 더하는 방식으로는 해결되지 않는다.
MIGRATOR_DB_USER=ttokttok_migrator
MIGRATOR_DB_PASSWORD=change-me

### Redis ###
REDIS_PASSWORD=change-me

### MinIO (S3 호환 오브젝트 스토리지) ###
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars

# 기존 S3 버킷명을 그대로 쓴다. 저장된 파일 URL 이 "<도메인>/<키>" 형태라 URL 자체에
# 버킷명은 없지만, nginx 가 path-style 요청으로 바꿀 때 이 이름을 경로에 끼워 넣는다.
MINIO_BUCKET=ttokttokbucket

# 앱 전용 서비스 계정. root 자격증명을 앱에 주지 않기 위해 minio-init 이 만든다.
MINIO_APP_ACCESS_KEY=ttokttok-app
MINIO_APP_SECRET_KEY=change-me-at-least-8-chars

### 파일 공개 도메인 ###
# 이관 전 CloudFront 도메인을 그대로 유지한다. 이 값이 바뀌면 DB 에 절대 URL 로
# 저장된 기존 파일 링크가 전부 깨지고, 마크다운 본문과 JSON 내부까지 치환해야 한다.
FILE_CLOUD_URL=https://www.ddockddock-file.co.kr

### Firebase ###
# config/ 디렉터리에 놓아둔 서비스 계정 키의 파일명.
# 앱 컨테이너에는 /app/config/<이 이름> 으로 마운트된다.
FIREBASE_JSON_NAME=ttokttok-push-firebase-adminsdk-example.json

### SMTP 릴레이 ###
# 이 서버는 직접 발송이 불가능하다(PTR 없음 + Spamhaus PBL). 반드시 외부 릴레이를 쓴다.
SMTP_RELAYHOST=[smtp.naver.com]:587
SMTP_RELAY_USER=noreply@example.com
SMTP_RELAY_PASSWORD=change-me

### compose ###
# Postfix 의 mynetworks 도 이 대역으로 제한된다. 바꾸면 둘 다 같이 바뀐다.
COMPOSE_SUBNET=172.28.0.0/16

### 배포 상태 (deploy.sh 가 자동으로 갱신한다. 손대지 말 것) ###
BLUE_TAG=none
GREEN_TAG=none
