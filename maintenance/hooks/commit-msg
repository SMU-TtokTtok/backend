#!/usr/bin/env bash
#
# commit-msg: ③ enforce commit message format  [#issue] - message
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$HOOK_DIR/lib.sh"

msg_file="$1"
first_line="$(head -n 1 "$msg_file")"

# Allow auto-generated / rebase messages.
case "$first_line" in
  Merge*|Revert*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

if ! printf '%s' "$first_line" | grep -Eq '^\[#[0-9]+\] - .+'; then
  block "커밋 메시지 형식이 올바르지 않습니다." \
        "현재: $first_line" \
        "형식: [#이슈번호] - 메시지   (예: [#312] - 즐겨찾기 도메인 로직 추가)"
fi

exit 0
