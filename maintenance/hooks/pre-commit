#!/usr/bin/env bash
#
# pre-commit: ① block direct commits on protected branches
#             ② block staging of secret files
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$HOOK_DIR/lib.sh"

# ① Protected-branch direct commit
branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo '')"
if is_protected "$branch"; then
  block "보호 브랜치 '$branch'에 직접 커밋할 수 없습니다." \
        "→ feature 브랜치(예: feat/#123)를 만들어 작업한 뒤 PR로 머지하세요."
fi

# ② Secret-file guard (catches even 'git add -f' of gitignored files)
staged="$(git diff --cached --name-only)"
secrets=""
while IFS= read -r path; do
  [ -z "$path" ] && continue
  if is_secret_path "$path"; then
    secrets="$secrets$path"$'\n'
  fi
done <<EOF
$staged
EOF

if [ -n "$secrets" ]; then
  block "민감 파일이 스테이징되었습니다 (커밋 금지):" $secrets \
        "→ git restore --staged <file> 로 제외하세요. 이 파일들은 .gitignore 대상입니다."
fi

exit 0
